{
    "name": "pr-run",
    "version": "0.1.25",
    "description": "Run and inspect pull request branches locally with worktrees, env files, Docker, scripts, terminals, and diffs.",
    "type": "module",
    "main": "dist-electron/main.js",
    "bin": {
        "pr-run": "./bin/pr-run.cjs"
    },
    "files": [
        "bin",
        "dist",
        "src/backend",
        "src/cli",
        "src/types",
        "tsconfig.json",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/felipe-software/pr-run.git"
    },
    "bugs": {
        "url": "https://github.com/felipe-software/pr-run/issues"
    },
    "homepage": "https://github.com/felipe-software/pr-run#readme",
    "license": "MIT",
    "packageManager": "bun@1.3.14",
    "scripts": {
        "backend": "bun src/backend/server.ts",
        "backend:dev": "PR_RUN_BACKEND_PORT=33134 bun --watch src/backend/server.ts",
        "build:npm": "bun run build:renderer",
        "renderer:dev": "bunx vite dev  --port 33133",
        "dev": "sh -c 'trap \"kill 0\" EXIT; bun run backend:dev & bun run renderer:dev'",
        "build": "bun run build:renderer && bun run build:electron",
        "build:electron": "tsc -p tsconfig.electron.json && cp electron/package.json dist-electron/package.json",
        "build:renderer": "tsc -b tsconfig.app.json && vite build",
        "electron": "bun run build && electron .",
        "electron:dev": "sh -c 'trap \"kill 0\" EXIT; bun run backend:dev & bun run renderer:dev & bun run build:electron && ELECTRON_BACKEND_URL=http://localhost:33134 ELECTRON_RENDERER_URL=http://localhost:33133 ELECTRON_SKIP_BACKEND_HEALTHCHECK=1 electron .'",
        "format": "prettier --write .",
        "prepare": "husky",
        "prepack": "bun run build:npm",
        "preview": "vite preview",
        "release": "semantic-release",
        "release:dry-run": "semantic-release --dry-run",
        "test": "bun test",
        "typecheck": "tsc -b"
    },
    "dependencies": {
        "@base-ui/react": "^1.4.1",
        "@elysiajs/cors": "^1.4.2",
        "@fontsource-variable/dm-sans": "^5.2.8",
        "@fontsource/jetbrains-mono": "^5.2.8",
        "@formkit/auto-animate": "^0.9.0",
        "@pierre/diffs": "^1.2.10",
        "@tanstack/react-hotkeys": "^0.10.0",
        "@tanstack/react-query": "^5.101.2",
        "@tanstack/react-query-persist-client": "^5.101.2",
        "@tanstack/react-virtual": "^3.14.5",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/xterm": "^6.0.0",
        "class-variance-authority": "^0.7.1",
        "dayjs": "^1.11.21",
        "effect": "^3.21.3",
        "elysia": "^1.4.28",
        "idb-keyval": "^6.3.0",
        "ky": "^2.0.2",
        "lucide-react": "^1.18.0",
        "node-gyp": "^13.0.0",
        "node-pty": "^1.1.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "react-markdown": "^10.1.0",
        "rehype-raw": "^7.0.0",
        "rehype-sanitize": "^6.0.0",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.4.0",
        "zod": "^4.4.3",
        "zustand": "^5.0.14"
    },
    "devDependencies": {
        "@semantic-release/commit-analyzer": "^13.0.1",
        "@semantic-release/git": "^10.0.1",
        "@semantic-release/github": "^12.0.9",
        "@semantic-release/npm": "^13.1.5",
        "@semantic-release/release-notes-generator": "^14.1.1",
        "@tailwindcss/vite": "^4.3.0",
        "@types/bun": "^1.3.14",
        "@types/node": "^25.9.3",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^6.0.2",
        "conventional-changelog-conventionalcommits": "^10.2.1",
        "electron": "^42.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.0.7",
        "prettier": "^3.8.4",
        "prettier-plugin-classnames": "^0.10.2",
        "prettier-plugin-merge": "^0.10.1",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "semantic-release": "^25.0.5",
        "tailwindcss": "^4.3.0",
        "typescript": "^6.0.3",
        "vite": "^8.0.16"
    },
    "lint-staged": {
        "*.{ts,tsx,js,cjs,mjs,json,md,yaml,yml,html,css}": "prettier --write"
    }
}
